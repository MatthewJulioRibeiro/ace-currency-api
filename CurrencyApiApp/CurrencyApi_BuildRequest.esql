CREATE COMPUTE MODULE CurrencyApi_BuildRequest
	CREATE FUNCTION Main() RETURNS BOOLEAN
	BEGIN
		SET Environment.CurrencyApi.correlationId = UUIDASCHAR;
		SET Environment.CurrencyApi.endpoint = '/api/currency';

		DECLARE queryString CHARACTER COALESCE(InputRoot.HTTPInputHeader."X-Query-String", '');
		DECLARE fromCcy CHARACTER UPPER(TRIM(GetQueryParam(queryString, 'from')));
		DECLARE toCcy CHARACTER UPPER(TRIM(GetQueryParam(queryString, 'to')));
		DECLARE amountStr CHARACTER GetQueryParam(queryString, 'amount');

		IF amountStr = '' THEN
			SET amountStr = '1';
		END IF;

		IF fromCcy = '' OR toCcy = '' THEN
			SET Environment.CurrencyApi.errorCode = 'MISSING_PARAM';
			SET Environment.CurrencyApi.errorMessage = 'Informe from e to (codigos ISO de moeda) e opcionalmente amount, ex: ?from=USD&to=BRL&amount=100';
			THROW USER EXCEPTION MESSAGE 9001 VALUES('MISSING_PARAM', 'from and to are required query params');
		END IF;

		SET Environment.CurrencyApi.fromCcy = fromCcy;
		SET Environment.CurrencyApi.toCcy = toCcy;
		SET Environment.CurrencyApi.amount = amountStr;

		SET Environment.Variables.Log4j.LogText = '{"ts":"' || CAST(CURRENT_TIMESTAMP AS CHARACTER FORMAT 'yyyy-MM-dd''T''HH:mm:ss.SSS''Z''')
			|| '","correlationId":"' || Environment.CurrencyApi.correlationId
			|| '","step":"request","endpoint":"/api/currency","from":"' || fromCcy
			|| '","to":"' || toCcy || '","amount":"' || amountStr || '"}';

		RETURN TRUE;
	END;

	-- Extracts the value of `key` from a raw "a=1&b=2" query string.
	-- Returns '' when the key is absent. The WSInput node (unlike the
	-- newer HTTPInput node) does not pre-split the query string into
	-- individual fields, so this has to be done by hand.
	CREATE FUNCTION GetQueryParam(IN qs CHARACTER, IN pkey CHARACTER) RETURNS CHARACTER
	BEGIN
		DECLARE searchKey CHARACTER pkey || '=';
		DECLARE startPos INTEGER POSITION(searchKey IN qs);
		DECLARE valueStart INTEGER;
		DECLARE remainder CHARACTER;
		DECLARE ampPos INTEGER;
		DECLARE result CHARACTER '';
		IF startPos > 0 THEN
			SET valueStart = startPos + LENGTH(searchKey);
			SET remainder = SUBSTRING(qs FROM valueStart);
			SET ampPos = POSITION('&' IN remainder);
			IF ampPos = 0 THEN
				SET result = remainder;
			ELSE
				SET result = SUBSTRING(remainder FROM 1 FOR ampPos - 1);
			END IF;
		END IF;
		RETURN result;
	END;
END MODULE;
