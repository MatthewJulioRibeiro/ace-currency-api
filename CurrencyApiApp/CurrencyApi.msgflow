      <!-- shared error replies: each error node's "out" terminal fans out
           to two independent targets: HTTP Reply gets its own copy of
           the message directly (status code guaranteed correct, same as
           the original design), and a second copy goes to Log4j so client
           errors (400) and upstream failures (502) are still traceable by
           correlationId, same as successful requests. -->
      <connections xmi:type="eflow:FCMConnection" xmi:id="FCMConnection_8" targetNode="FCMComposite_1_6" sourceNode="FCMComposite_1_5" sourceTerminalName="OutTerminal.out" targetTerminalName="InTerminal.in"/>
