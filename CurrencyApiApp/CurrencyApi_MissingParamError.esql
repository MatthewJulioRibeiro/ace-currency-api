CREATE COMPUTE MODULE CurrencyApi_MissingParamError
	CREATE FUNCTION Main() RETURNS BOOLEAN
	BEGIN
		SET OutputRoot.Properties = InputRoot.Properties;
		SET OutputRoot.Properties.MessageDomain = 'JSON';
		SET OutputRoot.Properties.ReplyProtocol = 'HTTP';
		SET OutputRoot.HTTPResponseHeader."Content-Type" = 'application/json';
		SET OutputRoot.HTTPResponseHeader."Cache-Control" = 'no-store';
		SET OutputLocalEnvironment.Destination.HTTP.ReplyStatusCode = 400;
		SET OutputRoot.JSON.Data.error = COALESCE(Environment.CurrencyApi.errorCode, 'MISSING_PARAM');
		SET OutputRoot.JSON.Data.message = COALESCE(Environment.CurrencyApi.errorMessage,
			'Informe from e to (codigos ISO de moeda) e opcionalmente amount, ex: ?from=USD&to=BRL&amount=100');

		RETURN TRUE;
	END;
END MODULE;
