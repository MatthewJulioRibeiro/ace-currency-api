CREATE COMPUTE MODULE CurrencyApi_MissingParamError
	CREATE FUNCTION Main() RETURNS BOOLEAN
	BEGIN
		DECLARE correlationId CHARACTER COALESCE(Environment.CurrencyApi.correlationId, UUIDASCHAR);

		SET OutputRoot.Properties = InputRoot.Properties;
		SET OutputRoot.Properties.MessageDomain = 'JSON';
		SET OutputRoot.Properties.ReplyProtocol = 'HTTP';
		SET OutputRoot.HTTPResponseHeader."Content-Type" = 'application/json';
		SET OutputRoot.HTTPResponseHeader."Cache-Control" = 'no-store';
		SET OutputRoot.HTTPResponseHeader."Access-Control-Allow-Origin" = '*';
		SET OutputRoot.HTTPResponseHeader."Access-Control-Expose-Headers" = 'X-Correlation-Id';
		SET OutputRoot.HTTPResponseHeader."X-Correlation-Id" = correlationId;
		SET OutputLocalEnvironment.Destination.HTTP.ReplyStatusCode = 400;
		SET Environment.CurrencyApi.httpStatus = 400;
		SET OutputRoot.JSON.Data.error = COALESCE(Environment.CurrencyApi.errorCode, 'MISSING_PARAM');
		SET OutputRoot.JSON.Data.message = COALESCE(Environment.CurrencyApi.errorMessage,
			'Informe from e to (codigos ISO de moeda) e opcionalmente amount, ex: ?from=USD&to=BRL&amount=100');

		SET Environment.Variables.Log4j.LogText = '{"ts":"' || CAST(CURRENT_TIMESTAMP AS CHARACTER FORMAT 'yyyy-MM-dd''T''HH:mm:ss.SSS''Z''')
			|| '","correlationId":"' || correlationId
			|| '","step":"access","endpoint":"' || COALESCE(Environment.CurrencyApi.endpoint, '')
			|| '","status":400,"error":"' || COALESCE(Environment.CurrencyApi.errorCode, 'MISSING_PARAM') || '"}';

		RETURN TRUE;
	END;
END MODULE;
