CREATE COMPUTE MODULE CurrencyApi_MissingParamError
	CREATE FUNCTION Main() RETURNS BOOLEAN
	BEGIN
		SET OutputRoot.HTTP.Headers."Content-Type" = 'application/json';
		SET OutputLocalEnvironment.Destination.HTTP.ReplyStatusCode = 400;
		SET OutputRoot.JSON.Data.error = 'MISSING_PARAM';
		SET OutputRoot.JSON.Data.message = 'Informe from e to (codigos ISO de moeda) e opcionalmente amount, ex: ?from=USD&to=BRL&amount=100';

		RETURN TRUE;
	END;
END MODULE;
