CREATE COMPUTE MODULE CurrencyApi_BuildManyResponse
	-- Mirrors CurrencyApi_BuildResponse's triangulation (rate(from,to) =
	-- eur[to] / eur[from]) against the same cached bulk table, just once
	-- per pair in "pairs=USD-BRL,EUR-JPY,..." instead of once per request.
	-- An invalid or unknown pair reports its own ok/error inline in
	-- "results" -- same pattern as the Mule weather API's /compare
	-- endpoint -- instead of failing the whole batch.
	--
	-- The "results" array is built as a plain JSON string, not via the
	-- tree API's [index] assignment: a first attempt using
	-- OutputRoot.JSON.Data.results[idx].field = value deployed and ran
	-- without error, but serialized as three separate top-level "results"
	-- keys instead of one array with three elements -- the same class of
	-- serialization quirk already documented in
	-- CurrencyApi_BuildRatesResponse.esql for dynamic field names, just
	-- showing up for integer array indices here instead. Confirmed live
	-- before settling on this string-building approach.
	CREATE FUNCTION Main() RETURNS BOOLEAN
	BEGIN
		DECLARE correlationId CHARACTER Environment.CurrencyApi.correlationId;
		DECLARE amountIn DECIMAL CAST(Environment.CurrencyApi.amount AS DECIMAL);
		DECLARE remaining CHARACTER Environment.CurrencyApi.pairsRaw;
		DECLARE commaPos INTEGER;
		DECLARE token CHARACTER;
		DECLARE resultsJson CHARACTER '';
		DECLARE isFirst BOOLEAN TRUE;

		WHILE LENGTH(TRIM(remaining)) > 0 DO
			SET commaPos = POSITION(',' IN remaining);
			IF commaPos = 0 THEN
				SET token = TRIM(remaining);
				SET remaining = '';
			ELSE
				SET token = TRIM(SUBSTRING(remaining FROM 1 FOR commaPos - 1));
				SET remaining = SUBSTRING(remaining FROM commaPos + 1);
			END IF;

			IF LENGTH(token) > 0 THEN
				DECLARE dashPos INTEGER POSITION('-' IN token);
				DECLARE fromCcy CHARACTER '';
				DECLARE toCcy CHARACTER '';
				IF dashPos > 0 THEN
					SET fromCcy = UPPER(TRIM(SUBSTRING(token FROM 1 FOR dashPos - 1)));
					SET toCcy = UPPER(TRIM(SUBSTRING(token FROM dashPos + 1)));
				END IF;

				DECLARE itemJson CHARACTER '';

				IF fromCcy = '' OR toCcy = '' THEN
					SET itemJson = '{"pair":"' || token || '","ok":false,"error":"INVALID_PAIR"}';
				ELSE
					DECLARE fromToEur DECIMAL 1;
					DECLARE toToEur DECIMAL 1;
					DECLARE foundFrom BOOLEAN (fromCcy = 'EUR');
					DECLARE foundTo BOOLEAN (toCcy = 'EUR');

					DECLARE ref REFERENCE TO Environment.CurrencyApi.rates.*[1];
					WHILE LASTMOVE(ref) DO
						IF FIELDNAME(ref) = fromCcy THEN
							SET fromToEur = CAST(FIELDVALUE(ref) AS DECIMAL);
							SET foundFrom = TRUE;
						END IF;
						IF FIELDNAME(ref) = toCcy THEN
							SET toToEur = CAST(FIELDVALUE(ref) AS DECIMAL);
							SET foundTo = TRUE;
						END IF;
						MOVE ref NEXTSIBLING;
					END WHILE;

					IF NOT foundFrom OR NOT foundTo THEN
						SET itemJson = '{"pair":"' || fromCcy || '-' || toCcy || '","ok":false,"error":"UNKNOWN_CURRENCY"}';
					ELSE
						DECLARE rate DECIMAL ROUND(toToEur / fromToEur, 6);
						DECLARE convertedAmount DECIMAL ROUND(amountIn * rate, 4);

						-- Second-API enrichment (see CurrencyApi_BuildResponse):
						-- cross-reference fromCcy/toCcy -- already validated
						-- against Frankfurter's rates table above, not the
						-- request payload -- against countries.dev's bulk data.
						DECLARE fromCountryName CHARACTER '';
						DECLARE toCountryName CHARACTER '';
						IF EXISTS(Environment.CurrencyApi.countries.Item[]) THEN
							DECLARE cref REFERENCE TO Environment.CurrencyApi.countries.Item[1];
							WHILE LASTMOVE(cref) DO
								IF EXISTS(cref.currencies.Item[]) THEN
									DECLARE curRef REFERENCE TO cref.currencies.Item[1];
									WHILE LASTMOVE(curRef) DO
										IF curRef.code = fromCcy AND fromCountryName = '' THEN
											SET fromCountryName = cref.name;
										END IF;
										IF curRef.code = toCcy AND toCountryName = '' THEN
											SET toCountryName = cref.name;
										END IF;
										MOVE curRef NEXTSIBLING;
									END WHILE;
								END IF;
								MOVE cref NEXTSIBLING;
							END WHILE;
						END IF;

						SET itemJson = '{"pair":"' || fromCcy || '-' || toCcy || '"'
							|| ',"ok":true'
							|| ',"from":"' || fromCcy || '"'
							|| ',"to":"' || toCcy || '"'
							|| ',"amount":' || CAST(amountIn AS CHARACTER)
							|| ',"rate":' || CAST(rate AS CHARACTER)
							|| ',"convertedAmount":' || CAST(convertedAmount AS CHARACTER);
						IF fromCountryName <> '' THEN
							SET itemJson = itemJson || ',"fromCountry":"' || fromCountryName || '"';
						END IF;
						IF toCountryName <> '' THEN
							SET itemJson = itemJson || ',"toCountry":"' || toCountryName || '"';
						END IF;
						SET itemJson = itemJson || '}';
					END IF;
				END IF;

				IF NOT isFirst THEN
					SET resultsJson = resultsJson || ',';
				END IF;
				SET resultsJson = resultsJson || itemJson;
				SET isFirst = FALSE;
			END IF;
		END WHILE;

		DECLARE bodyText CHARACTER
			'{"cached":' || LOWER(CAST(Environment.CurrencyApi.cacheHit AS CHARACTER))
			|| ',"baseDate":"' || Environment.CurrencyApi.ratesDate || '"'
			|| ',"results":[' || resultsJson || ']}';

		SET OutputRoot.Properties = InputRoot.Properties;
		SET OutputRoot.Properties.MessageDomain = 'BLOB';
		SET OutputRoot.Properties.ReplyProtocol = 'HTTP';
		SET OutputRoot.HTTPResponseHeader."Content-Type" = 'application/json';
		SET OutputRoot.HTTPResponseHeader."Cache-Control" = 'no-store';
		SET OutputRoot.HTTPResponseHeader."Access-Control-Allow-Origin" = '*';
		SET OutputRoot.HTTPResponseHeader."Access-Control-Expose-Headers" = 'X-Correlation-Id';
		SET OutputRoot.HTTPResponseHeader."X-Correlation-Id" = correlationId;
		SET OutputLocalEnvironment.Destination.HTTP.ReplyStatusCode = 200;
		SET OutputRoot.BLOB.BLOB = CAST(bodyText AS BLOB CCSID 1208 ENCODING 546);

		SET Environment.Variables.Log4j.LogText = '{"ts":"' || CAST(CURRENT_TIMESTAMP AS CHARACTER FORMAT 'yyyy-MM-dd''T''HH:mm:ss.SSS''Z''')
			|| '","correlationId":"' || correlationId
			|| '","step":"access","endpoint":"/api/currency/convert-many","pairs":"' || Environment.CurrencyApi.pairsRaw
			|| '","status":200,"cached":' || LOWER(CAST(Environment.CurrencyApi.cacheHit AS CHARACTER))
			|| ',"transaction":' || bodyText || '}';

		RETURN TRUE;
	END;
END MODULE;
